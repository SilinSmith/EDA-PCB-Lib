             r["point_img"] = [round(float(v), 1) for v in r["point_img"]]
             if r.get("anchor_img"):
                 r["anchor_img"] = [round(float(v), 1) for v in r["anchor_img"]]
+            # _CAP_MARK_STAGE1_PIN_COLOR_CAP：把实测点沿「框边锚点→点」方向拉回到不超过 CAP 像素处。
+            # 动机（官方 10GT 实测）：彩色实测点落在红桩末端（外距中位 19.3px），
